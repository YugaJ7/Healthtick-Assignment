[Unit]
Description=Android in the browser: backend (video relay and input)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service
# Keep retrying for as long as it takes; the default gives up after 5 quick failures.
StartLimitIntervalSec=0

[Service]
User=androidweb
WorkingDirectory=/opt/android-web/backend
EnvironmentFile=/etc/android-web.env
Environment=HOME=/home/androidweb
ExecStart=/opt/node/bin/node src/server.js
# The backend exits if the Android device is not ready yet (for example right after a
# reboot, while the container is still starting). systemd then tries again.
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
